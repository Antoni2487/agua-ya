{
  "name": "aguaya-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel del Administrador de EPSEL y panel público de transparencia de AguaYa",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
