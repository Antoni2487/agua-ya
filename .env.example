# Copiar a .env y completar. Nunca commitear .env.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/aguaya
DB_USER=aguaya
DB_PASSWORD=aguaya

# CORS: orígenes del panel web y del panel público, separados por coma
CORS_ORIGINS=http://localhost:5173

# Geocerca (RF05)
GEOCERCA_RADIO_METROS=50

# --- Se usan desde feature/auth ---
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=30
# log | twilio
OTP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
