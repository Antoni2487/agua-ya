# Copiar a .env y completar. Nunca commitear .env.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/aguaya
# En prod (Render) también se puede usar DB_HOST, DB_PORT y DB_NAME en lugar de DB_URL
DB_USER=aguaya
DB_PASSWORD=aguaya

# CORS: orígenes del panel web y del panel público, separados por coma
CORS_ORIGINS=http://localhost:5173

# Geocerca (RF05)
GEOCERCA_RADIO_METROS=50
# Antigüedad máxima de la última posición GPS para validar la geocerca
GEOCERCA_VIGENCIA_POSICION_SEGUNDOS=120

# Auth (en dev hay un JWT_SECRET por defecto; en prod es obligatorio, mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=30
# log | twilio
OTP_PROVIDER=log
# Solo dev: devuelve el código OTP en la respuesta de /api/auth/otp/solicitar (prohibido en prod)
OTP_EXPONER_CODIGO=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Nombres del vecino a partir de su DNI al registrarse. local: nombres de prueba | miapi: miapi.cloud
DNI_PROVIDER=local
DNI_API_URL=https://miapi.cloud/v1/dni/
# Bearer token de miapi.cloud (no commitear)
DNI_API_TOKEN=
# La API puede tardar más de 20 s
DNI_TIMEOUT_SEGUNDOS=30

# Notificaciones push (Expo). log: solo escribe en el log | expo: Expo Push API
PUSH_PROVIDER=log
# Opcional: solo si el proyecto Expo tiene activado "push seguro"
EXPO_ACCESS_TOKEN=
# Distancia de la cisterna a la parada para avisar al vecino que está cerca
PUSH_RADIO_CERCANIA_METROS=500

# Web Push para la web del vecino. log: solo escribe en el log | vapid: envía de verdad
WEB_PUSH_PROVIDER=log
# Generar el par una vez con: npx web-push generate-vapid-keys (la privada no se commitea)
WEB_PUSH_CLAVE_PUBLICA=
WEB_PUSH_CLAVE_PRIVADA=
# Contacto para los servicios de push (mailto: o https:)
WEB_PUSH_SUJETO=mailto:aguaya@example.com
WEB_PUSH_TTL_SEGUNDOS=3600

# Swagger UI y /v3/api-docs (false para ocultarlos en un despliegue público)
SWAGGER_ENABLED=true
# Rendimiento: conexiones máximas a la BD y segundos de caché del panel público
DB_POOL_MAX=10
CACHE_SEGUNDOS=120
